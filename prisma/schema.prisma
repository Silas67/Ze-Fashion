// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Waitlist {
  id            String   @id @default(uuid())
  full_name     String?
  email         String   @unique
  phone         String?
  city          String?
  interest_level String?
  early_access  Boolean?
  created_at    DateTime @default(now())
}
